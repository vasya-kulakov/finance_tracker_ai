# Скопируй в .env и подставь свои значения — .env в .gitignore, наружу не уйдёт.
#
# Локальный запуск / pytest (нужен свой PostgreSQL на 127.0.0.1):
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=finance_db

# Через Docker Compose эти же переменные читаются отсюда же,
# но DB_HOST переопределяется в docker-compose.yml на "db" —
# трогать руками для docker-запуска не нужно.
